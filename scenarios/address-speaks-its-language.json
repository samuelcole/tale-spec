{
  "format": "tale-surface-scenario",
  "version": 5,
  "id": "address-speaks-its-language",
  "title": "An address speaks its language",
  "steps": [
    {
      "id": "spanish-device-plain-address",
      "action": { "op": "open-book-address", "clean": true, "deviceLanguage": "es-MX", "address": "https://tale.fyi/dracula-scenario" },
      "expect": {
        "state": { "equals": "book" },
        "canonicalBook": { "equals": "/dracula-scenario" },
        "addressPath": { "equals": "/es/dracula-scenario" },
        "interfaceLanguage": { "equals": "es" },
        "bookLanguage": { "equals": "en" },
        "canonicalAddress": { "equals": "https://tale.fyi/dracula-scenario" },
        "languageAlternates": { "equals": [] }
      }
    },
    {
      "id": "copy-gives-the-plain-address",
      "action": { "op": "copy-passage" },
      "expect": {
        "copiedUrl": { "equals": "https://tale.fyi/dracula-scenario" }
      }
    },
    {
      "id": "brazilian-device-plain-address",
      "action": { "op": "open-book-address", "clean": true, "deviceLanguage": "pt-BR", "address": "https://tale.fyi/dracula-scenario" },
      "expect": {
        "state": { "equals": "book" },
        "canonicalBook": { "equals": "/dracula-scenario" },
        "addressPath": { "equals": "/pt/dracula-scenario" },
        "interfaceLanguage": { "equals": "pt" },
        "bookLanguage": { "equals": "en" },
        "canonicalAddress": { "equals": "https://tale.fyi/dracula-scenario" },
        "languageAlternates": { "equals": [] }
      }
    },
    {
      "id": "english-device-spanish-address",
      "action": { "op": "open-book-address", "clean": true, "deviceLanguage": "en", "address": "https://tale.fyi/es/dracula-scenario" },
      "expect": {
        "state": { "equals": "book" },
        "canonicalBook": { "equals": "/dracula-scenario" },
        "addressPath": { "equals": "/es/dracula-scenario" },
        "interfaceLanguage": { "equals": "es" },
        "canonicalAddress": { "equals": "https://tale.fyi/dracula-scenario" },
        "languageAlternates": { "equals": [] }
      }
    },
    {
      "id": "read-at-the-spanish-address",
      "action": { "op": "read-forward", "extent": "several-screens" },
      "expect": {
        "readingExtent": { "equals": "several-screens" },
        "settled": { "equals": true }
      },
      "capture": { "successor": "successor" }
    },
    {
      "id": "place-carries-to-the-plain-address",
      "action": { "op": "end-session-and-open-address", "address": "https://tale.fyi/dracula-scenario" },
      "expect": {
        "state": { "equals": "book" },
        "addressPath": { "equals": "/dracula-scenario" },
        "interfaceLanguage": { "equals": "en" },
        "readerBlock": { "equals": { "ref": "successor" } }
      }
    },
    {
      "id": "choose-spanish-moves-the-address",
      "action": { "op": "choose-interface-language", "language": "es" },
      "expect": {
        "canonicalBook": { "equals": "/dracula-scenario" },
        "addressPath": { "equals": "/es/dracula-scenario" },
        "interfaceLanguage": { "equals": "es" }
      }
    },
    {
      "id": "choose-english-moves-it-back",
      "action": { "op": "choose-interface-language", "language": "en" },
      "expect": {
        "canonicalBook": { "equals": "/dracula-scenario" },
        "addressPath": { "equals": "/dracula-scenario" },
        "interfaceLanguage": { "equals": "en" }
      }
    },
    {
      "id": "chosen-english-outranks-a-spanish-address",
      "action": { "op": "end-session-and-open-address", "address": "https://tale.fyi/es/dracula-scenario" },
      "expect": {
        "state": { "equals": "book" },
        "addressPath": { "equals": "/dracula-scenario" },
        "interfaceLanguage": { "equals": "en" },
        "readerBlock": { "equals": { "ref": "successor" } }
      }
    },
    {
      "id": "german-device-plain-address",
      "action": { "op": "open-book-address", "clean": true, "deviceLanguage": "de-DE", "address": "https://tale.fyi/dracula-scenario" },
      "expect": {
        "state": { "equals": "book" },
        "canonicalBook": { "equals": "/dracula-scenario" },
        "addressPath": { "equals": "/de/dracula-scenario" },
        "interfaceLanguage": { "equals": "de" },
        "bookLanguage": { "equals": "en" },
        "canonicalAddress": { "equals": "https://tale.fyi/dracula-scenario" },
        "languageAlternates": { "equals": [] }
      }
    },
    {
      "id": "english-device-german-address",
      "action": { "op": "open-book-address", "clean": true, "deviceLanguage": "en", "address": "https://tale.fyi/de/dracula-scenario" },
      "expect": {
        "state": { "equals": "book" },
        "canonicalBook": { "equals": "/dracula-scenario" },
        "addressPath": { "equals": "/de/dracula-scenario" },
        "interfaceLanguage": { "equals": "de" },
        "bookLanguage": { "equals": "en" },
        "canonicalAddress": { "equals": "https://tale.fyi/dracula-scenario" },
        "languageAlternates": { "equals": [] }
      }
    },
    {
      "id": "read-at-the-german-address",
      "action": { "op": "read-forward", "extent": "several-screens" },
      "expect": {
        "readingExtent": { "equals": "several-screens" },
        "settled": { "equals": true }
      },
      "capture": { "germanSuccessor": "successor" }
    },
    {
      "id": "german-place-carries-to-the-plain-address",
      "action": { "op": "end-session-and-open-address", "address": "https://tale.fyi/dracula-scenario" },
      "expect": {
        "state": { "equals": "book" },
        "addressPath": { "equals": "/dracula-scenario" },
        "interfaceLanguage": { "equals": "en" },
        "readerBlock": { "equals": { "ref": "germanSuccessor" } }
      }
    },
    {
      "id": "choose-german-moves-the-address",
      "action": { "op": "choose-interface-language", "language": "de" },
      "expect": {
        "canonicalBook": { "equals": "/dracula-scenario" },
        "addressPath": { "equals": "/de/dracula-scenario" },
        "interfaceLanguage": { "equals": "de" }
      }
    },
    {
      "id": "chosen-german-outranks-a-plain-address",
      "action": { "op": "end-session-and-open-address", "address": "https://tale.fyi/dracula-scenario" },
      "expect": {
        "state": { "equals": "book" },
        "addressPath": { "equals": "/de/dracula-scenario" },
        "interfaceLanguage": { "equals": "de" },
        "readerBlock": { "equals": { "ref": "germanSuccessor" } }
      }
    },
    {
      "id": "choose-english-from-german",
      "action": { "op": "choose-interface-language", "language": "en" },
      "expect": {
        "canonicalBook": { "equals": "/dracula-scenario" },
        "addressPath": { "equals": "/dracula-scenario" },
        "interfaceLanguage": { "equals": "en" }
      }
    },
    {
      "id": "chosen-english-outranks-a-german-address",
      "action": { "op": "end-session-and-open-address", "address": "https://tale.fyi/de/dracula-scenario" },
      "expect": {
        "state": { "equals": "book" },
        "addressPath": { "equals": "/dracula-scenario" },
        "interfaceLanguage": { "equals": "en" },
        "readerBlock": { "equals": { "ref": "germanSuccessor" } }
      }
    },
    {
      "id": "a-portuguese-book-names-its-portuguese-address",
      "action": { "op": "open-book-address", "clean": true, "deviceLanguage": "en", "address": "https://tale.fyi/es/dom-casmurro-scenario" },
      "expect": {
        "state": { "equals": "book" },
        "canonicalBook": { "equals": "/dom-casmurro-scenario" },
        "addressPath": { "equals": "/es/dom-casmurro-scenario" },
        "interfaceLanguage": { "equals": "es" },
        "bookLanguage": { "equals": "pt" },
        "canonicalAddress": { "equals": "https://tale.fyi/pt/dom-casmurro-scenario" },
        "languageAlternates": { "equals": [] }
      }
    },
    {
      "id": "its-plain-address-names-the-same",
      "action": { "op": "open-book-address", "clean": true, "deviceLanguage": "en", "address": "https://tale.fyi/dom-casmurro-scenario" },
      "expect": {
        "state": { "equals": "book" },
        "canonicalBook": { "equals": "/dom-casmurro-scenario" },
        "addressPath": { "equals": "/dom-casmurro-scenario" },
        "interfaceLanguage": { "equals": "en" },
        "bookLanguage": { "equals": "pt" },
        "canonicalAddress": { "equals": "https://tale.fyi/pt/dom-casmurro-scenario" },
        "languageAlternates": { "equals": [] }
      }
    }
  ]
}
