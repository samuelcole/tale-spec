{
  "format": "tale-surface-scenario",
  "version": 1,
  "id": "kept-on-a-stalled-network",
  "title": "Kept on a stalled network",
  "steps": [
    {
      "id": "open-first-book",
      "action": { "op": "open-book", "book": "first", "clean": true, "network": "reachable" },
      "expect": {
        "state": { "equals": "book" },
        "cover": { "equals": "on-screen" },
        "position": { "equals": "start" },
        "dimBoundary": { "equals": null }
      },
      "capture": { "openingBlock": "firstBlock" }
    },
    {
      "id": "read-first-book",
      "action": { "op": "read-forward", "extent": "several-screens" },
      "expect": {
        "readingExtent": { "equals": "several-screens" },
        "topBlock": { "notEquals": { "ref": "openingBlock" } },
        "settled": { "equals": true },
        "keepControl": { "equals": "absent" },
        "keepToggle": { "equals": "absent" },
        "keepIndicator": { "equals": "absent" }
      },
      "capture": { "stoppedAt": "topBlock", "successor": "successor" }
    },
    {
      "id": "end-and-stall",
      "action": { "op": "end-session-and-set-network", "network": "stalled" },
      "expect": { "session": { "equals": "ended" }, "network": { "equals": "stalled" } }
    },
    {
      "id": "open-kept-book-stalled",
      "action": { "op": "open-book", "book": "first" },
      "expect": {
        "secondsToOpen": { "lessThanOrEqual": 3 },
        "state": { "equals": "book" },
        "cover": { "equals": "above-screen" },
        "topBlock": { "equals": { "ref": "successor" } },
        "dimBoundary": { "equals": { "ref": "stoppedAt" } },
        "firstInk": { "equals": { "ref": "successor" } },
        "dimIsOneRunFromTop": { "equals": true },
        "error": { "equals": "absent" },
        "spinner": { "equals": false }
      }
    },
    {
      "id": "read-on-while-stalled",
      "action": { "op": "read-forward", "extent": "several-screens" },
      "expect": {
        "readingExtent": { "equals": "several-screens" },
        "topBlock": { "notEquals": { "ref": "successor" } },
        "content": { "equals": "available" },
        "error": { "equals": "absent" },
        "spinner": { "equals": false }
      }
    },
    {
      "id": "open-never-started-book-stalled",
      "action": { "op": "open-book", "book": "second" },
      "expect": {
        "secondsToResolve": { "lessThanOrEqual": 12 },
        "state": { "equals": "offline-not-kept" },
        "message": { "equals": "you're offline, and you haven't started this one." },
        "explanation": { "equals": "a tale keeps itself once you've read a little of it." },
        "messageOrder": { "equals": "message-explanation-onward" },
        "cover": { "equals": "absent" },
        "prose": { "equals": "absent" },
        "spinner": { "equals": false },
        "wayOnward": { "equals": "available" }
      }
    },
    {
      "id": "take-way-onward",
      "action": { "op": "activate-way-onward", "retryNetwork": "reachable" },
      "expect": {
        "destination": { "equals": "book-or-kept-books" },
        "state": { "equals": "usable" }
      }
    }
  ]
}
