{
  "format": "tale-surface-scenario",
  "version": 5,
  "id": "read-in-your-language",
  "title": "Read in your language",
  "steps": [
    {
      "id": "english-home",
      "action": { "op": "open-library-search", "clean": true, "network": "reachable", "deviceLanguage": "en" },
      "expect": {
        "state": { "equals": "library" },
        "interfaceLanguage": { "equals": "en" },
        "leadingShelf": { "equals": null }
      }
    },
    {
      "id": "english-search",
      "action": { "op": "replace-library-query", "text": "helena" },
      "expect": {
        "state": { "equals": "library" },
        "bookOrder": { "equals": ["Helena's Path", "Helena"] },
        "bookLanguages": { "equals": [null, "Português"] }
      }
    },
    {
      "id": "a-guest-on-the-portuguese-shelf",
      "action": { "op": "open-browse-address", "address": "https://tale.fyi/language/pt" },
      "expect": {
        "state": { "equals": "shelf" },
        "canonicalIdentity": { "equals": "/language/pt" },
        "interfaceLanguage": { "equals": "en" },
        "rosterLanguages": { "equals": ["Português", "Português"] }
      }
    },
    {
      "id": "portuguese-home",
      "action": { "op": "open-library-search", "clean": true, "network": "reachable", "deviceLanguage": "pt" },
      "expect": {
        "state": { "equals": "library" },
        "interfaceLanguage": { "equals": "pt" },
        "leadingShelf": { "equals": "Português" },
        "leadingShelfBooks": { "equals": ["Dom Casmurro", "Helena"] }
      }
    },
    {
      "id": "portuguese-search",
      "action": { "op": "replace-library-query", "text": "helena" },
      "expect": {
        "state": { "equals": "library" },
        "bookOrder": { "equals": ["Helena", "Helena's Path"] },
        "bookLanguages": { "equals": [null, "English"] }
      }
    },
    {
      "id": "at-home-on-the-portuguese-shelf",
      "action": { "op": "open-browse-address", "address": "https://tale.fyi/language/pt" },
      "expect": {
        "state": { "equals": "shelf" },
        "canonicalIdentity": { "equals": "/language/pt" },
        "interfaceLanguage": { "equals": "pt" },
        "rosterLanguages": { "equals": [null, null] }
      }
    }
  ]
}
